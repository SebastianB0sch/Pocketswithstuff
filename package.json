{
  "name": "pockets-with-stuff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A dual-screen monster-collecting RPG in the style of the DS era",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "npm run build && node scripts/single-file.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.186.1"
  }
}
